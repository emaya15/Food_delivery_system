# Copy to .env and fill in. NEVER commit .env.

# MySQL connection (create the database first, see README)
DATABASE_URL=mysql+pymysql://fd_user:CHANGE_ME@localhost:3306/food_delivery

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (min 32 chars)
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Business timezone for opening hours, surge pricing and "today" in reports
TIMEZONE=Asia/Kolkata

# Set false to run without background jobs (e.g. when using several workers)
SCHEDULER_ENABLED=true

# Comma separated browser origins allowed by CORS (empty = CORS disabled)
CORS_ORIGINS=

DEBUG=false

# Docker Compose only (MySQL container)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=food_delivery
MYSQL_USER=fd_user
MYSQL_PASSWORD=CHANGE_ME
